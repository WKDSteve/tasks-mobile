{
  "name": "tasks-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The phone app of tasks-desktop: capture a task on the way and go through the vault, as an installable web app (PWA).",
  "license": "MIT",
  "scripts": {
    "dev": "vite --mode fake",
    "build": "vite build",
    "build:fake": "vite build --mode fake",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "pnpm build && pnpm build:fake && playwright test",
    "lint:chars": "python tools/check-control-chars.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "appkit-ui": "github:WKDSteve/appkit#v0.39.0&path:ui-kit"
  }
}
